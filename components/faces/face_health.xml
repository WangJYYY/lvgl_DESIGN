<!-- Health face: daily step-goal ring + heart-rate readout. Binds the global
     subject_steps / subject_hr directly (app-level face, not a reusable widget). -->
<component>
	<previews>
		<preview
			name="round_466"
			width="466"
			height="466"
			style_bg_color="0x000000"
			style_radius="233"
			style_clip_corner="true"
		/>
	</previews>

	<styles>
		<style name="style_goal_track" arc_width="14" arc_color="#color_watch_panel2" arc_rounded="true" />
		<style name="style_goal_ind" arc_width="14" arc_color="#color_ok" arc_rounded="true" />
		<style name="style_knob_hidden" bg_opa="0%" />
	</styles>

	<view width="466" height="466" scrollable="false" style_bg_opa="0%">
		<!-- Step-goal ring: fills as today's steps approach the 10k goal -->
		<lv_arc
			name="goal_ring"
			width="320"
			height="320"
			align="center"
			y="-50"
			clickable="false"
			min_value="0"
			max_value="10000"
			bg_start_angle="270"
			bg_end_angle="269"
			bind_value="subject_steps"
		>
			<style name="style_goal_track" selector="main" />
			<style name="style_goal_ind" selector="indicator" />
			<style name="style_knob_hidden" selector="knob" />
		</lv_arc>

		<!-- Step count in the middle of the ring -->
		<lv_label name="steps_label" align="center" y="-66" bind_text="subject_steps" style_text_font="font_h1" />
		<lv_label
			name="steps_caption"
			text="STEPS TODAY"
			align="center"
			y="-16"
			style_text_color="#color_watch_text2"
			style_text_font="font_h5"
		/>

		<!-- Heart-rate readout -->
		<lv_image
			name="hr_icon"
			src="icon_heart_48"
			align="center"
			x="-65"
			y="138"
			style_image_recolor="#color_danger"
			style_image_recolor_opa="100%"
		/>
		<lv_label
			name="hr_label"
			align="center"
			x="-4"
			y="142"
			bind_text="subject_hr"
			style_text_font="font_h2"
			style_text_color="#color_danger"
		/>
		<lv_label
			name="hr_caption"
			text="BPM"
			align="center"
			x="57"
			y="143"
			style_text_color="#color_watch_text2"
			style_text_font="font_h5"
		/>
	</view>
</component>
